<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#333F52" android:endColor="#1C2432" />
            <stroke android:width="2dp" android:color="#F5FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#252F3E" android:endColor="#141A24" />
            <stroke android:width="1dp" android:color="#2AFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
