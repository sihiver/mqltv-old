<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft emerald halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#3310B981" />
        </shape>
    </item>
    <!-- Middle glow ring with translucent white highlight -->
    <item
        android:top="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="#E610B981" />
            <stroke android:width="1.5dp" android:color="#AAFFFFFF" />
        </shape>
    </item>
    <!-- Crisp bright center core -->
    <item
        android:top="9dp"
        android:bottom="9dp"
        android:left="9dp"
        android:right="9dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>

