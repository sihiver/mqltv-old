<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Wallpaper Background -->
    <ImageView
        android:id="@+id/bg_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/launcher_wallpaper_fallback"
        android:contentDescription="@null" />

    <!-- Dark Translucent Backdrop (Consistent with App Library & Setelan Antarmuka) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0E17" />

    <!-- Centered Glass Panel -->
    <LinearLayout
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:padding="28dp">

        <!-- Top Kicker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="PROFIL PELANGGAN · MQLTV"
            android:textColor="#66FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:layout_marginBottom="16dp" />

        <!-- Header: Avatar & Identity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/account_avatar_bg"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/account_profile_letter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="?"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textSize="30sp"
                    android:textColor="#FFFFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/account_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Pengguna"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/account_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@username"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:textColor="#88FFFFFF" />

            <TextView
                android:id="@+id/account_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="AKTIF"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textSize="11sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textColor="#34D399"
                android:background="@drawable/account_badge_active" />

        </LinearLayout>

        <!-- Subscription Details Glass Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/settings_group_card_bg"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="horizontal">

            <!-- Paket -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAKET LANGGANAN"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:textColor="#77FFFFFF" />

                <TextView
                    android:id="@+id/account_packages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Premium"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFFFF" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#1FFFFFFF" />

            <!-- Expired -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BERAKHIR PADA"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:textColor="#77FFFFFF" />

                <TextView
                    android:id="@+id/account_expires"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="-"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFFFF" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/account_close"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/settings_action_bg"
                android:textColor="@color/settings_item_text"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@+id/account_logout"
                android:text="Tutup" />

            <Button
                android:id="@+id/account_logout"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/account_logout_btn_bg"
                android:textColor="@color/account_logout_text"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@+id/account_close"
                android:text="Keluar (Logout)" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
