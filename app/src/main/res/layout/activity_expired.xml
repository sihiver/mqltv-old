<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C12"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Optional exact screenshot background. Add: res/drawable/subscription_expired.png -->
    <ImageView
        android:id="@+id/expired_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="centerCrop"
        android:contentDescription="Langganan berakhir" />

    <!-- Fallback UI if screenshot is not present -->
    <LinearLayout
        android:id="@+id/expired_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Jam digital -->
        <TextView
            android:id="@+id/expired_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="40dp"
            android:text="00:00:00"
            android:textColor="#FF4444"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textSize="36sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LAYANAN TIDAK AKTIF ●"
            android:textColor="#FFFF4444"
            android:fontFamily="monospace"
            android:letterSpacing="0.4"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="EXPIRED"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textSize="58sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Langganan Berakhir"
            android:textColor="#FFFF4444"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textSize="40sp" />

        <View
            android:layout_width="600dp"
            android:layout_height="1dp"
            android:layout_marginTop="40dp"
            android:background="#FFFF2222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:text="Masa aktif langganan IPTV Anda telah habis.\nSilakan perpanjang untuk melanjutkan akses ke semua channel."
            android:textColor="#AAAAAA"
            android:fontFamily="monospace"
            android:lineSpacingExtra="8dp"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#0AFFFF22">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Hubungi Admin"
                android:textColor="#FFFF8888"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textSize="30sp" />
        </LinearLayout>

        <Button
            android:id="@+id/expired_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="← KEMBALI"
            android:fontFamily="monospace"
            android:textColor="#FFFF8888"
            android:backgroundTint="#00000000"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- Running text (marquee) di bagian bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="⚠"
            android:textColor="#FFFF4444"
            android:fontFamily="monospace"
            android:textSize="16sp" />

        <!-- Marquee / running text -->
        <TextView
            android:id="@+id/expired_marquee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="  LANGGANAN ANDA TELAH BERAKHIR — HUBUNGI ADMIN UNTUK PERPANJANGAN MELALUI WHATSAPP / TELEGRAM — TERIMA KASIH TELAH MENGGUNAKAN LAYANAN KAMI  "
            android:textColor="#FFFF4444"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollHorizontally="true" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="54dp"
        android:text="ERR_SUBSCRIPTION_EXPIRED  |  CODE: 0x4E4F5355  |  SESSION TERMINATED"
        android:textColor="#333333"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:textSize="13sp" />

</FrameLayout>
