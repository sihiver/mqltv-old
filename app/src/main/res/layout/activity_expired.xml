<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C12"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Optional exact screenshot background. Add: res/drawable/subscription_expired.png -->
    <ImageView
        android:id="@+id/expired_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="centerCrop"
        android:contentDescription="Langganan berakhir" />

    <!-- Fallback UI if screenshot is not present -->
    <LinearLayout
        android:id="@+id/expired_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LAYANAN TIDAK AKTIF ●"
            android:textColor="#FFFF4444"
            android:fontFamily="monospace"
            android:letterSpacing="0.4"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="EXPIRED"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textSize="58sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Langganan Berakhir"
            android:textColor="#FFFF4444"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textSize="40sp" />

        <View
            android:layout_width="600dp"
            android:layout_height="1dp"
            android:layout_marginTop="40dp"
            android:background="#FFFF2222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:text="Masa aktif langganan IPTV Anda telah habis.\nSilakan perpanjang untuk melanjutkan akses ke semua channel."
            android:textColor="#AAAAAA"
            android:fontFamily="monospace"
            android:lineSpacingExtra="8dp"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#0AFFFF22">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perpanjang sekarang — WhatsApp / Telegram"
                android:textColor="#888888"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Hubungi Admin"
                android:textColor="#FFFF8888"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textSize="30sp" />
        </LinearLayout>

        <Button
            android:id="@+id/expired_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="← KEMBALI"
            android:fontFamily="monospace"
            android:textColor="#FFFF8888"
            android:backgroundTint="#00000000"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="bottom"
        android:background="#14FF2222"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ LANGGANAN ANDA TELAH BERAKHIR — HUBUNGI ADMIN UNTUK PERPANJANGAN"
            android:textColor="#FFFF4444"
            android:fontFamily="monospace"
            android:layout_marginStart="20dp"
            android:maxLines="1"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="50dp"
        android:text="ERR_SUBSCRIPTION_EXPIRED  |  CODE: 0x4E4F5355  |  SESSION TERMINATED"
        android:textColor="#333333"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:textSize="13sp" />

</FrameLayout>
