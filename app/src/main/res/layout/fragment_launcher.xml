<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#080B0F">

    <!-- Background Wallpaper -->
    <ImageView
        android:id="@+id/launcher_wallpaper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@null"
        android:alpha="0"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ambient Spotlight Glow (CleanYourTV / Apple TV style) -->
    <ImageView
        android:id="@+id/launcher_ambient_glow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:alpha="0.85"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Wallpaper Dim Overlay & Cinematic Vignette -->
    <View
        android:id="@+id/launcher_wallpaper_dim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/launcher_wallpaper_overlay"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Safe area guidelines to prevent TV overscan clipping -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/launcher_safe_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.04" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/launcher_safe_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.96" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/launcher_safe_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.04" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/launcher_safe_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.96" />

    <!-- CleanYourTV / tvOS Minimalist Header Bar (PINNED AT TOP, NEVER MOVES) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/launcher_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="@id/launcher_safe_left"
        app:layout_constraintEnd_toEndOf="@id/launcher_safe_right"
        app:layout_constraintTop_toTopOf="@id/launcher_safe_top">

                <!-- Left Block: Greeting + Clock + Date -->
                <LinearLayout
                    android:id="@+id/launcher_left_block"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <!-- Time-based Greeting ("SELAMAT MALAM" / "GOOD EVENING") -->
                    <TextView
                        android:id="@+id/launcher_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELAMAT DATANG"
                        android:textColor="#8CFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.20"
                        android:textAllCaps="true" />

                    <!-- Clock and Date Line -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:id="@+id/launcher_header_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="#FFFFFFFF"
                            android:textSize="44sp"
                            android:fontFamily="sans-serif-light"
                            android:textStyle="bold"
                            android:letterSpacing="-0.04"
                            android:includeFontPadding="false"
                            android:importantForAccessibility="no" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="14dp"
                            android:background="#30FFFFFF" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/launcher_header_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HARI INI"
                                android:textColor="#B3FFFFFF"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.12"
                                android:textAllCaps="true" />

                            <TextView
                                android:id="@+id/launcher_brand_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="MQLTV STREAM"
                                android:textColor="#66FFFFFF"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.16"
                                android:textAllCaps="true" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Right Block: tvOS Frosted Glass Action Pills -->
                <LinearLayout
                    android:id="@+id/launcher_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <!-- Network Status Pill -->
                    <LinearLayout
                        android:id="@+id/launcher_network_pill"
                        style="@style/TopButton"
                        android:focusable="false"
                        android:clickable="false"
                        android:layout_marginEnd="4dp">

                        <ImageView
                            android:id="@+id/launcher_header_net"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_mql_wifi"
                            android:tint="#FFFFFFFF"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/launcher_header_net_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="ONLINE"
                            android:textColor="#E6FFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <!-- Search Pill -->
                    <FrameLayout
                        android:id="@+id/launcher_search"
                        style="@style/TopButtonIcon"
                        android:contentDescription="Search"
                        android:nextFocusDown="@+id/launcher_apps"
                        android:nextFocusRight="@+id/launcher_notifications">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:duplicateParentState="true"
                            android:src="@android:drawable/ic_menu_search"
                            android:tint="@color/pill_text"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <!-- Notifications Pill -->
                    <FrameLayout
                        android:id="@+id/launcher_notifications"
                        style="@style/TopButtonIcon"
                        android:contentDescription="Notifications"
                        android:nextFocusDown="@+id/launcher_apps"
                        android:nextFocusLeft="@+id/launcher_search"
                        android:nextFocusRight="@+id/launcher_settings">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:duplicateParentState="true"
                            android:src="@drawable/ic_bell_outline"
                            android:tint="@color/pill_text"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/launcher_notifications_badge"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/badge_bg"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:text="0"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Settings Pill -->
                    <FrameLayout
                        android:id="@+id/launcher_settings"
                        style="@style/TopButtonIcon"
                        android:contentDescription="Settings"
                        android:nextFocusDown="@+id/launcher_apps"
                        android:nextFocusLeft="@+id/launcher_notifications"
                        android:nextFocusRight="@+id/launcher_native_settings">

                        <ImageView
                            android:id="@+id/launcher_settings_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:duplicateParentState="true"
                            android:src="@android:drawable/ic_menu_manage"
                            android:tint="@color/pill_text"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <!-- Native TV Settings Pill -->
                    <FrameLayout
                        android:id="@+id/launcher_native_settings"
                        style="@style/TopButtonIcon"
                        android:contentDescription="Native Settings"
                        android:nextFocusDown="@+id/launcher_apps"
                        android:nextFocusLeft="@+id/launcher_settings"
                        android:nextFocusRight="@+id/launcher_profile">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            android:duplicateParentState="true"
                            android:src="@drawable/ic_gear_outline"
                            android:tint="@color/pill_text"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <!-- Profile / Account Pill -->
                    <FrameLayout
                        android:id="@+id/launcher_profile"
                        style="@style/TopButtonIcon"
                        android:contentDescription="Profile"
                        android:nextFocusDown="@+id/launcher_apps"
                        android:nextFocusLeft="@+id/launcher_native_settings">

                        <TextView
                            android:id="@+id/launcher_profile_letter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:duplicateParentState="true"
                            android:text="?"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/pill_text" />
                    </FrameLayout>

                </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable content area BELOW the pinned header (Header stays 100% static) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/launcher_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingBottom="24dp"
        app:layout_constraintStart_toStartOf="@id/launcher_safe_left"
        app:layout_constraintEnd_toEndOf="@id/launcher_safe_right"
        app:layout_constraintTop_toBottomOf="@id/launcher_header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- CleanYourTV Cinematic Top Shelf (Hero Section) -->
            <LinearLayout
                android:id="@+id/launcher_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginTop="225dp"
                android:layout_marginBottom="12dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Kicker / Tag (Hidden for CleanYourTV minimalist home) -->
                <LinearLayout
                    android:id="@+id/launcher_hero_kicker_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <View
                        android:id="@+id/launcher_hero_kicker_bar"
                        android:layout_width="3dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/hero_kicker_bar" />

                    <TextView
                        android:id="@+id/launcher_hero_kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MQLTV · LIVE ENTERTAINMENT"
                        android:textColor="#A0FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.18"
                        android:textAllCaps="true" />
                </LinearLayout>

                <!-- Hero Title (Clean, bold app title placed directly above the dock row) -->
                <TextView
                    android:id="@+id/launcher_hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE TV"
                    android:textColor="#FFFFFFFF"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-light"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false"
                    android:singleLine="true" />

                <!-- Hero Subtitle / Metadata (Hidden for CleanYourTV minimalist home) -->
                <TextView
                    android:id="@+id/launcher_hero_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="+5000 Saluran TV Lokal &amp; Internasional"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 4-Column Vertical App Grid (CleanYourTV style) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/launcher_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingTop="2dp"
                android:paddingBottom="48dp"
                android:nextFocusUp="@+id/launcher_search" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Single floating tvOS / CleanYourTV glass highlight that springs between tiles -->
    <com.mqltv.GlassView
        android:id="@+id/launcher_glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
