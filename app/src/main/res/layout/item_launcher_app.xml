<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="171dp"
    android:layout_height="96dp"
    android:layout_marginEnd="14dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:longClickable="true"
    android:clipToOutline="true"
    android:descendantFocusability="blocksDescendants">

    <ImageView
        android:id="@+id/launcher_app_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="Banner" />

    <LinearLayout
        android:id="@+id/launcher_app_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/launcher_app_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="App" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/launcher_app_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mql_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launcher_app_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#D9E2F2"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
