<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:longClickable="true"
    android:clipToOutline="true"
    android:descendantFocusability="blocksDescendants">

    <ImageView
        android:id="@+id/launcher_app_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:clipToOutline="true"
        android:contentDescription="Banner" />

    <LinearLayout
        android:id="@+id/launcher_app_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/launcher_app_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="App" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/launcher_app_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mql_text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launcher_app_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B0C0D4"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
