<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="220dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/launcher_card_bg_square"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:clipToOutline="true"
    android:descendantFocusability="blocksDescendants">

    <TextureView
        android:id="@+id/launcher_card_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <View
        android:id="@+id/launcher_card_video_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000"
        android:visibility="gone" />

    <!-- Subtle gradient overlay from bottom to keep text readable -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="@drawable/launcher_wallpaper_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/badge_bg"
                android:backgroundTint="#EF4444" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="LIVE STREAM"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/launcher_card_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:src="@drawable/tv_play_icon"
            android:tint="@color/mql_text_primary"
            android:duplicateParentState="true"
            android:contentDescription="Icon" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <TextView
            android:id="@+id/launcher_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live TV's"
            android:textColor="@color/mql_text_primary"
            android:textSize="20sp"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/launcher_card_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+5000 Channels"
            android:textColor="@color/mql_text_secondary"
            android:duplicateParentState="true"
            android:textSize="13sp" />

        <View
            android:id="@+id/launcher_card_indicator"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/hero_kicker_bar"
            android:duplicateParentState="true"
            android:visibility="invisible" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/launcher_card_focus_frame_square"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:duplicateParentState="true" />

</FrameLayout>
