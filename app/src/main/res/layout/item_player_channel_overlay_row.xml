<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_channel_row"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    android:background="@drawable/player_channel_row_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <TextView
        android:id="@+id/player_channel_row_number"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:minWidth="34dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:gravity="center"
        android:text="1"
        android:textColor="#EEFFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/live_tv_number_badge_bg" />

    <FrameLayout
        android:id="@+id/player_channel_row_logo"
        android:layout_width="46dp"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:padding="4dp"
        android:background="@drawable/live_tv_channel_logo_bg">

        <ImageView
            android:id="@+id/player_channel_row_logo_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/player_channel_row_logo_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="TV"
            android:textColor="#FF1E293B"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:importantForAccessibility="no" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/player_channel_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Channel 01"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/player_channel_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Program info LIVE TV"
            android:textColor="#88FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/player_channel_row_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="5dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/player_channel_row_progress_bg" />

    </LinearLayout>

</LinearLayout>
